# Copy this file to .env.local and fill it in, then RESTART the dev server.
# Next.js only reads env files at startup — editing one while `npm run dev`
# is running changes nothing until you stop and start it again.
#
# .env.local is git-ignored. Never commit real credentials.

# ---------------------------------------------------------------- email out
# Where every form submission is sent. Defaults to info@ibcr.rw.
IBCR_SUBMISSION_EMAIL=info@ibcr.rw

# The From address. Must be a mailbox the SMTP account below is allowed to
# send as, or the server will reject the message.
IBCR_SUBMISSION_FROM="IBCR Website <info@ibcr.rw>"

# --- Option 1: SMTP (use this with a normal mailbox — Zoho, Google, cPanel)
#
# Zoho Mail:      smtp.zoho.com        port 465
# Google Workspace: smtp.gmail.com     port 465
# cPanel / InMotion: mail.yourdomain   port 465
#
# IBCR_SMTP_PASS must be an APP PASSWORD, not your normal login password.
# In Zoho: Settings → Security → App Passwords → Generate.
IBCR_SMTP_HOST=smtp.zoho.com
IBCR_SMTP_PORT=465
IBCR_SMTP_USER=info@ibcr.rw
IBCR_SMTP_PASS=

# --- Option 2: Resend (an API key instead of a mailbox)
# Only used when the SMTP values above are not set.
# IBCR_RESEND_API_KEY=

# ------------------------------------------------------------- extra sinks
# Optional. Every submission is also POSTed here as JSON — Zapier, Make, a CRM.
# IBCR_SUBMISSION_WEBHOOK=
