# Copy this file to .env.local and fill it in, then RESTART the dev server.
# Next.js only reads env files at startup — editing one while `npm run dev`
# is running changes nothing until you stop and start it again.
#
# .env.local is git-ignored. Never commit real credentials.

# ---------------------------------------------------------------- email out
# Where every form submission is sent. Defaults to info@ibcr.rw.
IBCR_SUBMISSION_EMAIL=info@ibcr.rw

# The From address. Must be a mailbox the SMTP account below is allowed to
# send as, or the server will reject the message.
IBCR_SUBMISSION_FROM="IBCR Website <info@ibcr.rw>"

# --- Option 1: SMTP (use this with a normal mailbox)
#
# InMotion / cPanel hosting — the settings below are the usual ones. Confirm
# them in cPanel → Email Accounts → the row for info@ibcr.rw → CONNECT DEVICES
# → "Mail Client Manual Settings". Use the SECURE SSL/TLS values shown there.
#
#   IBCR_SMTP_HOST   mail.ibcr.rw   (or the server hostname cPanel shows)
#   IBCR_SMTP_PORT   465            (or 587 if 465 is blocked)
#   IBCR_SMTP_USER   the FULL address, info@ibcr.rw — not just "info"
#   IBCR_SMTP_PASS   that mailbox's own password, from cPanel → Email Accounts
#
# If the site runs on the SAME InMotion server, you can skip the credentials
# entirely and relay locally, which never fails on a blocked port:
#
#   IBCR_SMTP_HOST=localhost
#   IBCR_SMTP_PORT=25
#   (leave IBCR_SMTP_USER and IBCR_SMTP_PASS empty)
#
# Zoho Mail:        smtp.zoho.com   465   (password = an app password)
# Google Workspace: smtp.gmail.com  465   (password = an app password)
#
# Check any of these with:  npm run mail:test
IBCR_SMTP_HOST=mail.ibcr.rw
IBCR_SMTP_PORT=465
IBCR_SMTP_USER=info@ibcr.rw
IBCR_SMTP_PASS=

# Set to true only if your host presents a certificate matching the mail
# domain. Shared hosts usually do not, so this stays off by default.
# IBCR_SMTP_STRICT_TLS=true

# --- Option 2: Resend (an API key instead of a mailbox)
# Only used when the SMTP values above are not set.
# IBCR_RESEND_API_KEY=

# ------------------------------------------------------------- extra sinks
# Optional. Every submission is also POSTed here as JSON — Zapier, Make, a CRM.
# IBCR_SUBMISSION_WEBHOOK=
